{
  "permission": {
    "executeCode": {
      "*": "allow"
    },
    "edit": {
      "*.md": "allow",
      "*.R": "allow",
      "*.qmd": "allow"
    },
    "bash": {
      "mkdir *": "allow",
      "mv *": "allow",
      "cd *": "allow",
      "set *": "allow",
